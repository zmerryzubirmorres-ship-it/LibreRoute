<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/m3_outline_variant" app:cardBackgroundColor="@color/m3_surface_container_lowest">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/tv_node_flag" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:textSize="12sp" android:text="VDS" android:importantForAccessibility="no" android:textColor="@color/m3_on_primary_container" android:background="@drawable/bg_admin_node_icon" android:fontFamily="sans-serif-medium" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
        <TextView android:id="@+id/tv_node_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="17sp" android:fontFamily="sans-serif-medium" tools:text="VDS-Amsterdam" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/tv_node_endpoint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace" tools:text="89.208.x.x:22 • VDS (Ubuntu 24.04)" />
      </LinearLayout>
      <TextView android:id="@+id/tv_node_status_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:textColor="@color/colorSuccess" android:background="@drawable/bg_remote_badge" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textStyle="normal" tools:text="АКТИВЕН" />
    </LinearLayout>
    <TextView android:id="@+id/tv_node_core" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="12sp" tools:text="Core 1.2.3 · Совместим с клиентом" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start" android:layout_marginTop="10dp">
      <TextView android:id="@+id/tv_node_latency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="0dp" android:paddingVertical="3dp" android:background="@android:color/transparent" android:textColor="@color/m3_primary" android:textSize="12sp" android:fontFamily="sans-serif" tools:text="⚡ 38 ms" />
      <TextView android:id="@+id/tv_node_clients" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:paddingHorizontal="0dp" android:paddingVertical="3dp" android:background="@android:color/transparent" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="sans-serif" tools:text="👥 4 пользователя" android:layout_marginTop="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layout_node_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" android:visibility="gone" tools:visibility="visible">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tv_node_cpu_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CPU" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView android:id="@+id/tv_node_cpu_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/m3_primary" android:textSize="11sp" android:fontFamily="monospace" tools:text="18%" />
      </LinearLayout>
      <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/pb_node_cpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" app:indicatorColor="@color/m3_primary" app:trackColor="@color/m3_outline_variant" app:trackCornerRadius="4dp" app:trackThickness="4dp" tools:progress="18" android:visibility="gone" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/tv_node_ram_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Память" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView android:id="@+id/tv_node_ram_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/colorSuccess" android:textSize="11sp" android:fontFamily="monospace" tools:text="420 / 1024 MB" />
      </LinearLayout>
      <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/pb_node_ram" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" app:indicatorColor="@color/colorSuccess" app:trackColor="@color/m3_outline_variant" app:trackCornerRadius="4dp" app:trackThickness="4dp" tools:progress="41" />
    </LinearLayout>
    <TextView android:id="@+id/tv_node_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/colorError" android:textSize="11sp" android:visibility="gone" tools:visibility="visible" tools:text="Ошибка опроса: connection refused" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="12dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_node_ping" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:textSize="14sp" android:text="Проверить" app:cornerRadius="12dp" android:layout_weight="1" android:minHeight="52dp" android:textAllCaps="false" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btn_node_manage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingHorizontal="12dp" android:textSize="14sp" android:text="Управление" app:cornerRadius="12dp" android:layout_weight="1" android:minHeight="52dp" android:textAllCaps="false" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>