<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:focusableInTouchMode="true" android:background="@drawable/bg_screen_ambient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:paddingHorizontal="8dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_arrow_back" app:tint="@color/text_primary" android:contentDescription="@string/cancel" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/routing_title" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:maxLines="2" />
        <ImageView android:id="@+id/routing_profiles" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_settings" app:tint="@color/m3_primary" android:contentDescription="@string/zapret_profiles_title" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
        <ImageView android:id="@+id/routing_help" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_info" app:tint="@color/text_secondary" android:contentDescription="@string/routing_help" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/routing_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/routing_sections" android:layout_width="match_parent" android:layout_height="44dp" app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_apps" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/routing_apps" android:textAllCaps="false" android:textSize="14sp" app:icon="@drawable/ic_apps" app:iconSize="18dp" app:cornerRadius="12dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_sites" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/routing_sites" android:textAllCaps="false" android:textSize="14sp" app:icon="@drawable/ic_domain" app:iconSize="18dp" app:cornerRadius="12dp" android:insetTop="0dp" android:insetBottom="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/routing_default_tunnel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/routing_default_tunnel" android:textSize="13sp" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/routing_default_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/routing_default_hint_tunnel" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/routing_standalone_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/routing_standalone_hint" android:textSize="12sp" android:textColor="@color/calm_warning" android:layout_marginBottom="8dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/routing_russian_preset" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/routing_russian_preset" android:textSize="13sp" android:textAllCaps="false" app:icon="@drawable/ic_domain" app:iconSize="18dp" app:cornerRadius="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/routing_enabled" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/routing_enabled_apps" android:textSize="13sp" android:textColor="@color/text_primary" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/routing_show_system" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/routing_system" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_add_site" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/site_add" android:textSize="12sp" android:textAllCaps="false" android:visibility="gone" app:icon="@drawable/ic_add" app:iconSize="16dp" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/routing_search" app:endIconMode="clear_text">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/routing_search" android:layout_width="match_parent" android:layout_height="48dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none" android:fillViewport="false">
                <com.google.android.material.chip.ChipGroup android:id="@+id/routing_filters" android:layout_width="wrap_content" android:layout_height="match_parent" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp">
                    <com.google.android.material.chip.Chip android:id="@+id/routing_filter_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_group_all" android:checkable="true" app:checkedIconVisible="false" />
                    <com.google.android.material.chip.Chip android:id="@+id/routing_filter_direct" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_group_direct" android:checkable="true" app:checkedIconVisible="false" app:chipIconSize="10dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/routing_filter_zapret" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_group_zapret" android:checkable="true" app:checkedIconVisible="false" app:chipIconSize="10dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/routing_filter_tunnel" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_group_tunnel" android:checkable="true" app:checkedIconVisible="false" app:chipIconSize="10dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/routing_filter_inherit" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routing_group_inherit" android:checkable="true" app:checkedIconVisible="false" app:chipIconSize="10dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
            <TextView android:id="@+id/routing_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/routing_selection_hint" android:textSize="11sp" android:textColor="@color/text_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
                <TextView android:id="@+id/routing_selected_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/m3_primary" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/routing_visible_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:textSize="11sp" android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_select_all" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/routing_select_all" android:textSize="11sp" android:textAllCaps="false" android:minWidth="0dp" android:paddingHorizontal="8dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_clear_selection" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/routing_clear_selection" android:textSize="11sp" android:textAllCaps="false" android:minWidth="0dp" android:paddingHorizontal="8dp" android:insetTop="0dp" android:insetBottom="0dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/m3_outline_variant" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/routing_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp" />
        <ProgressBar android:id="@+id/routing_loading" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:indeterminateTint="@color/m3_primary" />
        <TextView android:id="@+id/routing_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="24dp" android:gravity="center" android:textColor="@color/text_secondary" android:visibility="gone" />
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView android:id="@+id/routing_assignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:visibility="gone" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/m3_surface_container_low" app:strokeColor="@color/m3_outline_variant" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/routing_actions" android:layout_width="match_parent" android:layout_height="40dp" app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_direct" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Напрямую" android:textSize="12sp" android:textAllCaps="false" android:minWidth="0dp" android:paddingHorizontal="6dp" app:cornerRadius="10dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_zapret" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Через zapret" android:textSize="12sp" android:textAllCaps="false" android:minWidth="0dp" android:paddingHorizontal="6dp" app:cornerRadius="10dp" android:insetTop="0dp" android:insetBottom="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_tunnel" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Через туннель" android:textSize="12sp" android:textAllCaps="false" android:minWidth="0dp" android:paddingHorizontal="6dp" app:cornerRadius="10dp" android:insetTop="0dp" android:insetBottom="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout android:id="@+id/routing_profile_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/site_profile">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/routing_profile" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="none" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <ImageView android:id="@+id/routing_new_profile" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_add" app:tint="@color/m3_primary" android:contentDescription="@string/routing_create_profile" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
                <ImageView android:id="@+id/routing_edit_profile" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_edit" app:tint="@color/text_secondary" android:contentDescription="@string/routing_edit_profile" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_reset" style="?attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="8dp" android:contentDescription="@string/routing_inherit" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" app:iconPadding="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routing_apply" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/routing_apply" android:textAllCaps="false" android:textSize="13sp" app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
