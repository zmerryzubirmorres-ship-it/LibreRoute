<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_menu_popup">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_btn_request_rights"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Запрос ADMIN_JOIN_REQUEST связывается с вашим действующим профилем и подписывается аппаратным ключом устройства."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Profile Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Исходный VPN-профиль"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinner_join_profile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp" />

    <!-- Role Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Запрашиваемая роль"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinner_join_role"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp" />

    <!-- Fingerprint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/admin_fingerprint_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_join_fingerprint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/m3_primary"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_join"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_join"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Отправить запрос"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
