<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_deep">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingTop="24dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="8dp" android:background="@drawable/bg_home_hero">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/home_connection" android:textSize="12sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif-medium" />
                        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="0dp" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:background="@drawable/bg_home_status" android:text="Отключено" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical">
                        <TextView android:id="@+id/homeStateTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start" android:text="Защита отключена" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_weight="1" android:letterSpacing="-0.025" android:layout_marginEnd="12dp" />
                        <ImageView android:id="@+id/homeShieldIcon" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center_vertical" android:layout_marginTop="0dp" android:padding="14dp" android:src="@drawable/ic_shield" app:tint="@color/text_secondary" android:background="@drawable/bg_home_emblem" android:contentDescription="@null" />
                    </LinearLayout>
                    <TextView android:id="@+id/homeEvent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="start" android:text="Трафик направляется напрямую через провайдера" android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:minHeight="0dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/connectButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true" android:contentDescription="Подключить" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:strokeColor="@color/m3_primary" app:cardBackgroundColor="@color/m3_primary" app:rippleColor="#33FFFFFF">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:importantForAccessibility="noHideDescendants">
                            <ImageView android:id="@+id/connectPowerIcon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_power" app:tint="@color/m3_on_primary" android:contentDescription="@null" />
                            <TextView android:id="@+id/connectButtonLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Подключить" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/m3_on_primary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView android:id="@+id/cardTrafficRules" android:layout_width="56dp" android:layout_height="56dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/routing_title" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/m3_outline_variant" app:cardBackgroundColor="@color/m3_surface_container_lowest">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_split_tunnel" app:tint="@color/m3_primary" android:contentDescription="@null" android:importantForAccessibility="no" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/networkMetricsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="0dp" android:visibility="gone" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:strokeColor="@color/m3_outline_variant" app:cardBackgroundColor="@android:color/transparent">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="0dp" android:paddingVertical="4dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/channel_latency_label" android:textColor="@color/text_secondary" android:textSize="12sp" />
                                    <TextView android:id="@+id/metricPing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                                </LinearLayout>
                                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/m3_outline_variant" />
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓ Загрузка" android:textColor="@color/text_secondary" android:textSize="12sp" />
                                    <TextView android:id="@+id/metricDownload" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                                </LinearLayout>
                                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/m3_outline_variant" />
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑ Отдача" android:textColor="@color/text_secondary" android:textSize="12sp" />
                                    <TextView android:id="@+id/metricUpload" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                                </LinearLayout>
                            </LinearLayout>
                            <TextView android:id="@+id/metricHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="Появится после подключения" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:id="@+id/uptimeContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="12dp">
                        <TextView android:id="@+id/uptimeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/configSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_home_row" android:clickable="true" android:focusable="true" android:minHeight="96dp" android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_selected_profile" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/configPing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                        <ImageView android:id="@+id/configDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_dropdown_dot" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tunnelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Маршрут 1" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:maxLines="2" android:ellipsize="end" />
                            <TextView android:id="@+id/homeProfileDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        </LinearLayout>
                        <ImageView android:id="@+id/chevron" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_down" app:tint="@color/text_secondary" android:contentDescription="Выбрать маршрут" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/openAuthCheck" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:textAllCaps="false" />
                <LinearLayout android:id="@+id/homeSharingCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="12dp" android:background="@drawable/bg_home_row">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_connection_socks" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/homeSharingSwitch" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_share_socks" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:showText="false" android:layout_weight="1" />
                        <ImageButton android:id="@+id/homeSharingSettings" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_settings" android:contentDescription="@string/home_share_settings" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:id="@+id/homeSharingHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/homeSharingAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingVertical="8dp" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="@color/m3_outline_variant" />
                    <LinearLayout android:id="@+id/homeModeCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_router" android:contentDescription="@null" app:tint="@color/m3_primary" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/homeModeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/homeModeDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:contentDescription="@null" app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardAdminConsole" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="0dp" android:layout_marginTop="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/m3_surface_container_low">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical" android:minHeight="56dp">
                        <ImageView android:id="@+id/adminConsoleIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_shield" app:tint="@color/m3_primary" />
                        <TextView android:id="@+id/adminConsoleTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Администрирование" android:textColor="@color/text_primary" android:textSize="13sp" />
                        <TextView android:id="@+id/adminConsoleRoleBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OWNER" android:textColor="@color/m3_primary" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:id="@+id/homeDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="12dp" android:background="@drawable/bg_home_row">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/home_diagnostics" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogs" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/home_logs" android:textSize="13sp" android:textAllCaps="false" android:minWidth="64dp" android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="@string/home_local_socks" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/homeLocalStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:maxWidth="180dp" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="@string/home_server_transport" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/homeTransportStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:maxWidth="180dp" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="@string/home_zapret_profiles" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/homeZapretStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:maxWidth="180dp" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardSplitTunnel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/m3_outline_variant" app:cardBackgroundColor="@color/m3_surface_container_low">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                            <ImageView android:id="@+id/splitTunnelIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_split_tunnel" app:tint="@color/m3_primary" />
                            <TextView android:id="@+id/splitTunnelTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Раздельное туннелирование" android:textColor="@color/text_primary" />
                            <TextView android:id="@+id/splitTunnelSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/routesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/routesPanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Маршруты" android:textSize="24sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/routesPanelRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/settingsPanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настройки" android:textSize="24sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/settingsPanelRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <View android:id="@+id/btnSettings" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/userNavigation" android:layout_width="match_parent" android:layout_height="80dp" android:background="@color/m3_surface_container_low" app:labelVisibilityMode="labeled" app:menu="@menu/user_navigation" />
</LinearLayout>
