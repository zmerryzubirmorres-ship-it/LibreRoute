<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_ambient">

    <!-- ─────── Top bar: Settings + Config + Split Tunnel ─────── -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:padding="9dp"
        android:src="@drawable/ic_settings"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/settings_title"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/configSelector"
        app:layout_constraintBottom_toBottomOf="@id/configSelector"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/configSelector"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSettings"
        app:layout_constraintEnd_toStartOf="@id/btnLogs">

        <View
            android:id="@+id/configDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dropdown_dot"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tunnelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="170dp"
            tools:text="My Tunnel" />

        <TextView
            android:id="@+id/configPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/state_running"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            tools:text="45 мс"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnLogs"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:padding="9dp"
        android:src="@drawable/ic_terminal"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/logs_title"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/configSelector"
        app:layout_constraintBottom_toBottomOf="@id/configSelector"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@id/configSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Tap to connect" />

    <!-- ─────── Header: telemetry (speed + memory under statusText) ─────── -->
    <LinearLayout
        android:id="@+id/uptimeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minWidth="200dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Speed (Below Status, Clean Text without Background Pill) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/speedIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_speed"
                android:contentDescription="@null"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                tools:text="↓ 0 B/s   ↑ 0 B/s" />

        </LinearLayout>

        <io.github.p1neapplexpress.openflux.ui.widget.SpeedSparklineView
            android:id="@+id/speedSparkline"
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal" />

        <!-- Memory Monitor (RAM Usage) -->
        <LinearLayout
            android:id="@+id/memoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_memory"
                app:tint="@color/text_tertiary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/memoryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                tools:text="ОЗУ: 42 МБ" />

        </LinearLayout>

    </LinearLayout>

    <!-- ─────── Center: aurora + rings + button ─────── -->
    <FrameLayout
        android:id="@+id/center"
        android:layout_width="350dp"
        android:layout_height="350dp"
        app:layout_constraintTop_toBottomOf="@id/uptimeContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <io.github.p1neapplexpress.openflux.ui.widget.AuroraView
            android:id="@+id/aurora"
            android:layout_width="350dp"
            android:layout_height="350dp"
            android:layout_gravity="center" />

        <io.github.p1neapplexpress.openflux.ui.widget.PulseRingsView
            android:id="@+id/pulseRings"
            android:layout_width="324dp"
            android:layout_height="324dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/ringOuter"
            android:layout_width="276dp"
            android:layout_height="276dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:background="@drawable/bg_ring_outer" />

        <View
            android:id="@+id/ringMid"
            android:layout_width="236dp"
            android:layout_height="236dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:background="@drawable/bg_ring_mid" />

        <FrameLayout
            android:id="@+id/connectButton"
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_ripple"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/buttonContentContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/powerIcon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_power"
                    android:alpha="0.92"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/uptimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="00:42" />

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

    <!-- ─────── Bottom bar: Add (top) + Enter manually (bottom) ─────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Кнопка «Добавить» (по QR-коду) -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/add_tunnel_short"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/m3_on_primary"
            app:backgroundTint="@color/m3_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/m3_on_primary"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
