<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_deep">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_shield" app:tint="@color/m3_primary" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="LibreRoute" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
        <ImageView android:id="@+id/profileButton" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_person" app:tint="@color/text_primary" android:background="@drawable/bg_remote_badge" android:contentDescription="Профиль" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:background="@drawable/bg_home_status" android:text="Отключено" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" />
                <ImageView android:id="@+id/homeShieldIcon" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:padding="14dp" android:src="@drawable/ic_shield" app:tint="@color/text_secondary" android:background="@drawable/bg_ring_mid" android:contentDescription="@null" />
                <TextView android:id="@+id/homeStateTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Защита отключена" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/homeEvent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Трафик направляется напрямую через провайдера" android:textSize="10sp" android:textColor="@color/text_secondary" />
                <LinearLayout android:id="@+id/configSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_config_selector" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Выбранный маршрут" android:textSize="10sp" android:textColor="@color/text_secondary" />
                        <TextView android:id="@+id/configPing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:textColor="@color/text_secondary" android:textSize="10sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical">
                        <ImageView android:id="@+id/configDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_dropdown_dot" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tunnelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Маршрут 1" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Амстердам · Прямой шлюз" android:textSize="10sp" android:textColor="@color/text_secondary" />
                        </LinearLayout>
                        <ImageView android:id="@+id/chevron" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_down" app:tint="@color/text_secondary" android:contentDescription="Выбрать маршрут" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Подключить" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/m3_primary" app:cardBackgroundColor="@color/m3_primary">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:importantForAccessibility="noHideDescendants">
                        <ImageView android:id="@+id/connectPowerIcon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_power" app:tint="@color/m3_on_primary" android:contentDescription="@null" />
                        <TextView android:id="@+id/connectButtonLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Подключить" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/m3_on_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/addButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Импортировать приглашение" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/text_primary" app:icon="@drawable/ic_add" app:iconTint="@color/text_primary" app:iconGravity="textStart" app:iconPadding="6dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/connectServerButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Подключить свой сервер" android:textSize="12sp" android:textAllCaps="false" app:cornerRadius="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/openAuthCheck" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:textAllCaps="false" />
                <LinearLayout android:id="@+id/uptimeContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><TextView android:id="@+id/uptimeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_secondary" /></LinearLayout>
                <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/networkMetricsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:visibility="gone" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/m3_outline_variant" app:cardBackgroundColor="@color/m3_surface_container_low">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="10dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Задержка" android:textColor="@color/text_tertiary" android:textSize="10sp" /><TextView android:id="@+id/metricPing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" /></LinearLayout>
                                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/m3_outline_variant" />
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓ Загрузка" android:textColor="@color/text_tertiary" android:textSize="10sp" /><TextView android:id="@+id/metricDownload" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" /></LinearLayout>
                                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/m3_outline_variant" />
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑ Отдача" android:textColor="@color/text_tertiary" android:textSize="10sp" /><TextView android:id="@+id/metricUpload" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" /></LinearLayout>
                            </LinearLayout>
                            <TextView android:id="@+id/metricHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="Появится после подключения" android:textColor="@color/text_tertiary" android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardSplitTunnel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/m3_outline_variant" app:cardBackgroundColor="@color/m3_surface_container_low"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"><ImageView android:id="@+id/splitTunnelIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_split_tunnel" app:tint="@color/m3_primary" /><TextView android:id="@+id/splitTunnelTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Раздельное туннелирование" android:textColor="@color/text_primary" /><TextView android:id="@+id/splitTunnelSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" /></LinearLayout></com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/cardAdminConsole" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="10dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"><ImageView android:id="@+id/adminConsoleIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_shield" app:tint="@color/m3_primary" /><TextView android:id="@+id/adminConsoleTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Администрирование" android:textColor="@color/text_primary" /><TextView android:id="@+id/adminConsoleRoleBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OWNER" android:textColor="@color/m3_primary" /></LinearLayout></com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/routesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:id="@+id/routesPanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Маршруты" android:textSize="24sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp" /><LinearLayout android:id="@+id/routesPanelRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></LinearLayout>
            <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:id="@+id/settingsPanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настройки" android:textSize="24sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp" /><LinearLayout android:id="@+id/settingsPanelRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></LinearLayout>
            <View android:id="@+id/btnSettings" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><View android:id="@+id/btnLogs" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/userNavigation" android:layout_width="match_parent" android:layout_height="80dp" android:background="@color/m3_surface_container_low" app:labelVisibilityMode="labeled" app:menu="@menu/user_navigation" />
</LinearLayout>
