<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_ambient">

    <!-- Top Bar (Fixed Header) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_primary"
            android:contentDescription="@string/cancel" />

        <!-- Normal Title Container -->
        <LinearLayout
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/split_tunneling_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/btn_search_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/text_primary"
                android:contentDescription="@string/search_apps_hint" />

        </LinearLayout>

        <!-- Search Input Container -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/search_apps_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="16sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_clear"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_tertiary"
                android:contentDescription="@string/cancel" />

        </LinearLayout>

    </LinearLayout>

    <!-- Content Container (Eliminated NestedScrollView wrapping RecyclerView) -->
    <LinearLayout
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Section Switcher: Apps vs Sites -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/section_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_section_apps"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/split_section_apps"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_apps"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_section_sites"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/split_section_sites"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_domain"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

        <!-- 1. Apps Section Container -->
        <LinearLayout
            android:id="@+id/container_apps_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

                <!-- Mode Toggle (Bypass vs Proxy) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/mode_toggle_group"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tab_bypass"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/tab_bypass"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tab_proxy"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/tab_proxy"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

                <!-- Compact Subtle Info Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_tertiary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/mode_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        tools:text="Отмеченные приложения работают напрямую в обход VPN" />

                </LinearLayout>

                <!-- Filter Bar: Count + Hide System Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/selected_count_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/m3_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        tools:text="Выбрано: 15 из 82" />

                    <!-- Hide System Apps Switch -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_hide_system"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/split_hide_system_apps"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:checked="true" />

                </LinearLayout>

                <!-- Action Buttons Row: Select All & Reset Defaults -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_all"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/select_all"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        app:icon="@drawable/ic_check"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_secondary"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_defaults"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/reset_defaults"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_secondary"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/m3_outline_variant" />

                <!-- Apps List & States -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/apps_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="24dp" />

                    <ProgressBar
                        android:id="@+id/loading_progress"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="40dp"
                        android:indeterminateTint="@color/m3_primary" />

                    <LinearLayout
                        android:id="@+id/empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="40dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_tertiary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/no_apps_found"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- 2. Sites Section Container -->
            <LinearLayout
                android:id="@+id/container_sites_section"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Sites Mode Toggle (Bypass vs Proxy) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/sites_mode_toggle_group"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sites_tab_bypass"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/tab_bypass"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sites_tab_proxy"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/tab_proxy"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

                <!-- Compact Subtle Info Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_tertiary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/sites_mode_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        tools:text="Указанные сайты будут открываться напрямую в обход VPN" />

                </LinearLayout>

                <!-- Sites Action Bar: Row 1 Count Label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/sites_count_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/m3_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        tools:text="Добавлено: 12" />

                </LinearLayout>

                <!-- Sites Action Bar: Row 1 Primary Add Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_site"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="@string/split_sites_add_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        app:icon="@drawable/ic_add"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_secondary"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

                <!-- Sites Action Bar: Row 2 Secondary Buttons (Same size and style as Apps!) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_site_presets"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/split_sites_presets"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        app:icon="@drawable/ic_domain"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_secondary"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_sites"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/split_sites_clear"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        app:icon="@drawable/ic_delete"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_secondary"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/m3_outline_variant"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/m3_outline_variant" />

                <!-- Sites Recycler & Empty State -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/sites_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="24dp" />

                    <!-- Empty State without subtitle description -->
                    <LinearLayout
                        android:id="@+id/sites_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="40dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_domain"
                            app:tint="@color/text_tertiary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/split_sites_empty_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

    </LinearLayout>

</LinearLayout>
