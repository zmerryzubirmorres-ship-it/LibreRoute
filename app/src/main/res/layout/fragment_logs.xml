<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_ambient">

    <!-- Top Action Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/logs_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:navigationContentDescription="@string/cancel"
        app:contentInsetStartWithNavigation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_logs_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tv_line_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="0 строк" />

            </LinearLayout>

            <!-- Connection Log Level Selector -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connection_log_level"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/m3_surface_container_high"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_chevron_down"
                app:iconGravity="textEnd"
                app:iconSize="14dp"
                app:iconTint="@color/text_secondary"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                tools:text="INFO" />

            <!-- More Options (3 dots) -->
            <ImageView
                android:id="@+id/btn_logs_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/action_more"
                app:tint="@color/text_primary" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Terminal Console Window Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/m3_surface_container_lowest"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/m3_outline_variant"
        app:strokeWidth="1dp">

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp"
                android:textIsSelectable="true" />

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>